    "# Function that reshapes the images to (100,100,3)\n",
    "def image_reshape(img):\n",
    "    img = img.convert(\"RGB\")\n",
    "    img = img.resize((100, 100))\n",
    "    return np.array(img)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "727e4ad0-dea9-4125-912c-02b3797cad1d",
