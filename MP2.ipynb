    "def adjust_gamma(image, gamma=1.0):\n",
    "    invGamma = 1.0 / (gamma+1e-06)\n",
    "    table = np.array([((i / 255.0) ** invGamma) * 255\n",
    "        for i in np.arange(0, 256)]).astype(\"uint8\")\n",
    "    return cv.LUT(image, table)"
   ]
  },
  {
